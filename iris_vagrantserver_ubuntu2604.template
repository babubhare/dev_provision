Vagrant.configure("2") do |config|
  config.vm.box = "iris_vagrant/server_ubuntu2604"

  # Detect active host network connection using standard Ruby backticks to call PowerShell
  detected_switch = "Default Switch"
  begin
    # Query only active PHYSICAL adapters, ignoring Hyper-V virtual adapters
    net_query = `powershell -NoProfile -Command "(Get-NetAdapter -Physical | Where-Object { $_.Status -eq 'Up' } | Select-Object -First 1).InterfaceDescription"`.strip
    
    if !net_query.empty?
      if net_query =~ /Wi-Fi|Wireless|WLAN|802\.11/i
        detected_switch = "External_Wireless"
      else
        detected_switch = "External_Wired"
      end
    end
  rescue
    # Failsafe just in case the shell command fails
    detected_switch = "Default Switch"
  end

  # Add the network adapter and bridge it to the correctly detected external switch
  config.vm.network "public_network", bridge: detected_switch

  config.vm.provider "hyperv" do |v|
    v.memory = 8192
    v.cpus = 2
    v.vmname = "iris_ubuntu_server_2604"
    
    # Disable manual and automatic Hyper-V checkpoints
    v.enable_checkpoints = false
    v.enable_automatic_checkpoints = false

    # Automatic start and stop actions
    v.auto_start_action = "Nothing"
    v.auto_stop_action = "TurnOff"
  end

  # Configure SSH credentials
  config.ssh.username = "vagrant"
  config.ssh.private_key_path = "../../provision/ssh_login_private_key"
  
  # Force Vagrant to use ONLY the provided key and prevent it from inserting a new one
  config.ssh.insert_key = false

  # Configure custom SMB shared folder to sync relatively to /shared
  config.vm.synced_folder "../../../shared", "/shared", 
    type: "smb",
    smb_username: "smbuser",
    smb_password: "P@ssw0rd"

  config.vm.synced_folder ".", "/vagrant", disabled: true
  
  # Capture the dynamic system role passed securely from the PowerShell script
  system_role = ENV['VAGRANT_SYSTEM_ROLE'] || "default"
  
  # Reference provisioning scripts directly from the master root provision folder
  config.vm.provision "shell", 
    path: "../../provision/01_script_password.sh", 
    args: [system_role, "vagrant"]
    
  config.vm.provision "shell", 
    path: "../../provision/02_script_bashrc.sh", 
    args: [system_role, "root"]

  config.vm.provision "shell", 
    path: "../../provision/03_script_bashrc_root.sh"

  config.vm.provision "shell", 
    path: "../../provision/04_script_add_user.sh", 
    args: ["devuser", "devuser"]    
end